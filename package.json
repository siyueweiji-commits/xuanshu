{
  "name": "xuanshu",
  "productName": "XuanShu",
  "version": "0.1.0",
  "description": "玄枢 XuanShu — 开箱即用的离线命理应用（紫微斗数 / 八字 / 梅花易数 / 六爻 / 流日黄历）",
  "author": "XuanShu Team",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "deps:electron": "python scripts/fetch-native-deps.py",
    "shot": "node scripts/ui-shot.cjs",
    "verify:main": "node scripts/verify-main.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.electron.json && tsc --noEmit -p tsconfig.json",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "verify:m4": "node scripts/verify-m4.cjs",
    "verify:m5": "node scripts/verify-m5.cjs",
    "verify:m6": "node scripts/verify-m6.cjs",
    "verify:m7": "node scripts/verify-m7.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "iztro": "^2.0.0",
    "lunar-typescript": "^1.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
